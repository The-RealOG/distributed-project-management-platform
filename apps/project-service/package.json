    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@dpp/auth": "*",
    "@dpp/cache": "*",
    "@dpp/config": "*",
    "@dpp/contracts": "*",
    "@dpp/database": "*",
    "@dpp/observability": "*",
    "@dpp/runtime": "*",
    "@dpp/storage": "*",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@dpp/test-utils": "*",
    "@types/pg": "^8.23.1",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  }
}
