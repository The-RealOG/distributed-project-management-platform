{
  "name": "distributed-project-platform",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "npm run test:e2e -w @dpp/system-tests",
    "test:stack": "npm run test:stack -w @dpp/system-tests",
    "demo:kafka-outage": "npm run test:stack -w @dpp/system-tests -- stack/kafka-outage.stack.test.ts",
    "test:unit": "turbo run test",
    "test:docker": "turbo run test:integration --concurrency=1",
    "test:aws": "scripts/aws/test.sh",
    "aws:bootstrap": "scripts/aws/bootstrap.sh",
    "aws:plan": "scripts/aws/plan.sh",
    "aws:apply": "scripts/aws/apply.sh",
    "aws:deploy": "scripts/aws/deploy.sh",
    "aws:rollout": "scripts/aws/rollout.sh",
    "aws:migrate": "scripts/aws/migrate.sh",
    "aws:kafka:init": "scripts/aws/kafka-init.sh",
    "aws:kafka:probe": "scripts/aws/kafka-probe.sh",
    "aws:status": "scripts/aws/status.sh",
    "aws:logs": "scripts/aws/logs.sh",
    "aws:exec": "scripts/aws/exec.sh",
    "aws:db:tunnel": "scripts/aws/db-tunnel.sh",
    "aws:smoke": "scripts/aws/smoke.sh",
    "aws:test": "scripts/aws/test.sh",
    "aws:security-check": "scripts/aws/security-check.sh",
    "aws:cost-info": "scripts/aws/cost-info.sh",
    "aws:destroy": "scripts/aws/destroy.sh",
    "aws:destroy:all": "scripts/aws/destroy-all.sh",
    "aws:audit": "scripts/aws/audit.sh",
    "aws:demo": "scripts/aws/demo.sh",
    "aws:demo:realtime": "scripts/aws/demo-realtime.sh",
    "aws:demo:dlq": "scripts/aws/demo-dlq.sh",
    "aws:invariants": "scripts/aws/invariants.sh",
    "aws:demo:failures": "scripts/aws/demo-failures.sh",
    "aws:rebuild": "scripts/aws/rebuild.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
